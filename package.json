{
  "name": "chvm",
  "version": "1.0.6",
  "description": "Chrome Version Manager - Manage and run multiple Chromium versions on macOS ARM",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "chvm": "./dist/cli.js"
  },
  "scripts": {
    "manifest:fetch-versions": "bun ./src/manifest/fetch-versions.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/tests/e2e/**/*.test.ts'",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/tests/unit/**/*.test.ts'",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "chrome",
    "chromium",
    "version-manager",
    "macos",
    "arm",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.1",
    "@semantic-release/npm": "^13.1.1",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "semantic-release": "^25.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
